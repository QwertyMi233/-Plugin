{
  "manifest_version": 3,
  "name": "同学堂助手 · 联网 AI 版",
  "description": "课程队列、正常播放监测、题干提示解析、联网 AI 作答及平台完成状态核对。",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://tongxuetang.tongji.edu.cn/*", "http://127.0.0.1:18765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开同学堂助手" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [{ "matches": ["https://tongxuetang.tongji.edu.cn/*"], "js": ["core.js", "content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
