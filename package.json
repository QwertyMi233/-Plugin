{
  "name": "tongxuetang-desktop",
  "version": "0.2.4",
  "description": "同学堂助手桌面版，内置课程浏览器和持久化 AI 设置",
  "main": "src/main.cjs",
  "author": "Tongxuetang Assistant contributors",
  "license": "MIT",
  "scripts": {
    "prepare:app": "node scripts/prepare.cjs",
    "start": "npm run prepare:app && electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run prepare:app && node scripts/build-win.cjs",
    "dist:mac": "npm run prepare:app && node scripts/build-mac.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "cn.tongxuetang.assistant.desktop",
    "productName": "Tongxuetang Assistant",
    "artifactName": "Tongxuetang-Assistant-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "同学堂助手",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "artifactName": "Tongxuetang-Assistant-${version}-mac-${arch}.${ext}",
      "identity": null,
      "icon": "src/icon.icns"
    }
  }
}
